<?xml version="1.0" encoding="utf-8"?>
<package>
	<metadata minClientVersion="2.5">
		<id>LicenseManagement.EndUser</id>
		<version>3.2.0</version>
		<authors>HYMMA</authors>
		<owners>HYMMA</owners>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<license type="expression">MIT</license>
		<description>End-user SDK for license-management.com platform. Provides license validation, trial management, and activation handling for Windows desktop applications.</description>
		<releaseNotes>3.2.0: Additive — CompactLicense.FetchAsync + LicenseFormat (jws / es256 / eddsa) to fetch the compact JWS license for embedded / non-.NET consumers. The XML activation flow is unchanged. 3.0.1: Bug fixes — LicenseHandlingUninstall reads from disk (not install chain); LicenseSignatureValidationHandler now correctly distinguishes tampered files from key rotation (throws CryptographicException on tamper). 3.0.0: Audit-driven hardening release. Centralized HTTP plumbing (15s timeout, retry-with-backoff for 429/503, Retry-After honoring, Idempotency-Key on POST, X-Correlation-Id, RFC 7807 problem+json error parsing). Hardened XML signature validation (XmlResolver=null, public-key shape check). Typed exceptions instead of base Exception. ILicenseLogger interface for observability. PublisherPreferences.ToString() masks ApiKey. ConfigureAwait(false) applied consistently. Several public infrastructure types are now internal (LicenseValidationHandler, *ApiEndPoint, MainRegistryKeyIn*, NullDeviceIdFormatter). See CHANGELOG.md for full list.</releaseNotes>
		<projectUrl>https://github.com/HYMMA/LicenseManagement.EndUser</projectUrl>
		<repository type="git" url="https://github.com/HYMMA/LicenseManagement.EndUser.git" />
		<readme>README.md</readme>
		<tags>license licensing software-licensing trial-management activation desktop-app hymma license-management</tags>
		<dependencies>
			<group targetFramework=".NETFramework4.8.1">
				<dependency id="Hymma.HttpClientFactory" version="1.0.8" />
				<dependency id="Newtonsoft.Json" version="13.0.3" />
				<dependency id="System.Memory" version="4.5.0" />
				<dependency id="System.Threading.Tasks.Extensions" version="4.5.2" />
			</group>
			<group targetFramework="net8.0-windows7.0">
				<dependency id="DeviceId" version="6.9.0" />
				<dependency id="DeviceId.Windows" version="6.9.0" />
				<dependency id="DeviceId.Windows.Wmi" version="6.9.0" />
				<dependency id="Newtonsoft.Json" version="13.0.3" />
				<dependency id="System.Management" version="9.0.17" />
				<dependency id="System.Security.Cryptography.Xml" version="9.0.17" />
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="..\README.md" target="" />
		<file src="bin\Release\LicenseManagement.EndUser.dll" target="lib\net481" />
		<file src="bin\Release\LicenseManagement.EndUser.pdb" target="lib\net481" />
		<file src="..\LicenseManagement.EndUser.Net8\bin\Release\net8.0-windows\LicenseManagement.EndUser.dll" target="lib\net8.0-windows7.0" />
		<file src="..\LicenseManagement.EndUser.Net8\bin\Release\net8.0-windows\LicenseManagement.EndUser.pdb" target="lib\net8.0-windows7.0" />
	</files>
</package>
